# DB Variables
POSTGRES_DB=template_django_nuxt
POSTGRES_USER=template_django_nuxt
POSTGRES_PASSWORD=template_django_nuxt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO Variables
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_CUSTOM_DOMAIN=localhost/media

# Frontend Variables
NUXT_API_BASE_SERVER=http://backend:8000/api
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_API_DOCS_URL=/api/docs/

# Django Variables
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production

# Wagtail Variables
WAGTAIL_SITE_NAME=Template Wagtail Nuxt
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Broker celery Variables
RABBITMQ_USER=samva_platform
RABBITMQ_PASSWORD=samva_platform
RABBITMQ_URL=amqp://samva_platform:samva_platform@broker:5672/

# MQTT ingest (LoRaWAN) — apply a change with `make mqtt-restart` (from backend/)
# local = Mosquitto + simulator | ttn = The Things Network
MQTT_SOURCE=local
TTN_APP_ID=agriculture-unillanos
# TTN API key with the "Read application traffic" right
TTN_API_KEY=NNSXS....

# Assistant (chatbot) — local LLM served by Ollama; pull the model once with
# `make assistant-model` (from backend/). On a Mac, http://host.docker.internal:11434
# points at a native Ollama, which runs on the GPU instead of the container's CPU.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
